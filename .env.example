# ──────────────────────────────────────────────
# Environment Configuration (.env.example)
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=midterm_pipeline

# File Router - Threshold in MB
# Files <= threshold → Python Batch
# Files >  threshold → PySpark
SMALL_FILE_THRESHOLD_MB=200

# Batch size for Python CSV loader
BATCH_SIZE=5000

# Sample generator - default number of rows
DEFAULT_SAMPLE_ROWS=100000

# Data directory (where CSV files are located)
# DATA_DIR=../data

# Scheduler interval in minutes
SCHEDULER_INTERVAL_MINUTES=60

# API Server
API_HOST=0.0.0.0
API_PORT=8000
